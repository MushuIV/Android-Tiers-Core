		<defName>T5Backstory</defName>
		<title>Archotech luddite</title>
		<titleShort>Luddite</titleShort>
		<baseDesc>For the crime of disobeying their own kind, {PAWN_nameDef} was exiled from their archotech homeworld. {PAWN_nameDef} would misguide sapient life out of spite or simply for entertainment.</baseDesc>
				<bodyTypeGlobal>Hulk</bodyTypeGlobal>
		<slot>Adulthood</slot>
		<spawnCategories>
			<li>TranscendantBackstory</li>
		</spawnCategories>
		<skillGains>
		  <Artistic>3</Artistic>
		  <Intellectual>5</Intellectual>
          <Melee>-2</Melee>
          <Shooting>-2</Shooting>
