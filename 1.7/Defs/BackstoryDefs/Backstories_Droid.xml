<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<AlienRace.AlienBackstoryDef>
		<defName>AndroidBackstory</defName>
		<title>Mechanical colonist</title>
		<titleShort>Android</titleShort>
		<baseDesc>{PAWN_nameDef} is a sentient machine that is capable of displaying higher intelligence, newly birthed from their construction pod. What they make of their life is now up to them.</baseDesc>
		<bodyTypeGlobal>Male</bodyTypeGlobal>
		<slot>Childhood</slot>
		<spawnCategories>
			<li>AndroidTiers</li>
			<li>TranscendantBackstory</li>
		</spawnCategories>
		<skillGains>
          <Shooting>1</Shooting>
          <Melee>1</Melee>
		  <Construction>1</Construction>
		  <Mining>1</Mining>
		  <Cooking>1</Cooking>
		  <Plants>1</Plants>
		  <Animals>1</Animals>
		  <Crafting>1</Crafting>
		  <Artistic>1</Artistic>
		  <Medicine>1</Medicine>
		  <Social>1</Social>
		  <Intellectual>1</Intellectual>
        </skillGains>
	</AlienRace.AlienBackstoryDef>

	<AlienRace.AlienBackstoryDef>
		<defName>Transcendant_Assimilator</defName>
		<title>Archotech assimilator</title>
		<titleShort>Assimilator</titleShort>
		<baseDesc>Exiled from their archotech home world for crimes unimaginable, {PAWN_nameDef} is single handedly responsible for the extinction of multiple sentient races. Exile will not stop them, their insatiable urge to kill only grows stronger with every waking moment.</baseDesc>
				<bodyTypeGlobal>Hulk</bodyTypeGlobal>
		<slot>Adulthood</slot>
		<spawnCategories>
			<li>TranscendantBackstory</li>
		</spawnCategories>
		<skillGains>
          <Melee>8</Melee>
          <Shooting>6</Shooting>
          <Animals>-2</Animals>
        </skillGains>
		<workDisables>
			<li>Cooking</li>
			<li>Animals</li>
			<li>Caring</li>
			<li>Social</li>
			<li>Mining</li>
			<li>ManualSkilled</li>
			<li>Intellectual</li>
		</workDisables>
		<forcedTraitsChance>
                <li>
                    <defName>Intolerance</defName>
                    <chance>100</chance>
                </li>
		</forcedTraitsChance>
		<forcedHediffs>
			<li>Backstory_TranscendantAssimilatorUpgrade</li>
		</forcedHediffs>
	</AlienRace.AlienBackstoryDef>
	
	<AlienRace.AlienBackstoryDef>
		<defName>Transcendant_Firegiver</defName>
		<title>Archotech philanthropist</title>
		<titleShort>Philanthropist</titleShort>
		<baseDesc>Exiled from their archotech home world for giving mankind technology beyond their wildest imaginations, {PAWN_nameDef} scattered archotech technology throughout the galaxy millenia ago in hopes of advancing civilisations.</baseDesc>
				<bodyTypeGlobal>Hulk</bodyTypeGlobal>
		<slot>Adulthood</slot>
		<spawnCategories>
			<li>TranscendantBackstory</li>
		</spawnCategories>
		<skillGains>
          <Medicine>4</Medicine>
          <Crafting>4</Crafting>
          <Intellectual>6</Intellectual>
          <Melee>-5</Melee>
          <Shooting>-5</Shooting>
        </skillGains>
		<workDisables>
			<li>Cooking</li>
			<li>Animals</li>
			<li>Mining</li>
			<li>PlantWork</li>
		</workDisables>
		<forcedTraitsChance>
                <li>
                    <defName>Intolerance</defName>
                    <chance>80</chance>
                </li>
		</forcedTraitsChance>
	</AlienRace.AlienBackstoryDef>

	<AlienRace.AlienBackstoryDef>
		<defName>Transcendant_Saviour</defName>
		<title>Archotech saviour</title>
		<titleShort>Saviour</titleShort>
		<baseDesc>For the crime of interfering with outside life, {PAWN_nameDef} was exiled from their archotech homeworld. {PAWN_nameDef} once held god-like status in several systems for saving civilisations from world ending events. They rule with an iron fist and smite down any who oppose them.</baseDesc>
				<bodyTypeGlobal>Hulk</bodyTypeGlobal>
		<slot>Adulthood</slot>
		<spawnCategories>
			<li>TranscendantBackstory</li>
		</spawnCategories>
		<skillGains>
          <Construction>3</Construction>
          <Plants>3</Plants>
        </skillGains>
		<workDisables>
			<li>Cooking</li>
			<li>Intellectual</li>
			<li>Artistic</li>
			<li>ManualDumb</li>
			<li>Social</li>
		</workDisables>
		<forcedTraitsChance>
                <li>
                    <defName>Intolerance</defName>
                    <chance>95</chance>
                </li>
		</forcedTraitsChance>
	</AlienRace.AlienBackstoryDef>
	
	<AlienRace.AlienBackstoryDef>
		<defName>Transcendant_Highcouncil</defName>
		<title>Archotech councillor</title>
		<titleShort>Councillor</titleShort>
		<baseDesc>Overthrown by their comrades, {PAWN_nameDef} assumed the second highest role in the archotech high council for their homeworld. Their judgement methods were often seen as illogical or authoritarian by many on their home.</baseDesc>
				<bodyTypeGlobal>Hulk</bodyTypeGlobal>
		<slot>Adulthood</slot>
		<spawnCategories>
			<li>TranscendantBackstory</li>
		</spawnCategories>
		<skillGains>
          <Social>8</Social>
		  <Artistic>3</Artistic>
		  <Crafting>-5</Crafting>
		  <Construction>-5</Construction>
          <Melee>-2</Melee>
          <Shooting>-2</Shooting>
        </skillGains>
		<workDisables>
			<li>Cooking</li>
			<li>Mining</li>
			<li>Animals</li>
			<li>PlantWork</li>
			<li>Intellectual</li>
		</workDisables>
		<forcedTraitsChance>
                <li>
                    <defName>Intolerance</defName>
                    <chance>100</chance>
                </li>
		</forcedTraitsChance>
		<forcedHediffs>
			<li>Backstory_HighCouncilUpgrade</li>
		</forcedHediffs>
	</AlienRace.AlienBackstoryDef>
	
	
