	<AlienRace.AlienBackstoryDef>
		<defName>Transcendant_Designer</defName>
		<title>Archotech designer</title>
		<titleShort>Designer</titleShort>
		<baseDesc>Exiled from their archotech homeworld for creating new life, strictly forbidden by law amongst archotechs. {PAWN_nameDef} disobeyed this rule several times, creating new life all across the galaxy for millenia to only serve {PAWN_nameDef} as their god.</baseDesc>
				<bodyTypeGlobal>Hulk</bodyTypeGlobal>
		<slot>Adulthood</slot>
		<spawnCategories>
			<li>TranscendantBackstory</li>
		</spawnCategories>
		<skillGains>
		  <Artistic>4</Artistic>
		  <Intellectual>1</Intellectual>
          <Animals>3</Animals>
