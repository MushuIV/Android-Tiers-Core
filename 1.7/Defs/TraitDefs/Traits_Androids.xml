<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- T1 Simple Minded Trait -->
  <TraitDef>
		<defName>SimpleMindedAndroid</defName>
		<commonality>1</commonality>
		<degreeDatas>
			<li>
				<label>Simple minded</label>
				<description>Due to the limitations of this androids mind: they are only barely able to understand and feel emotion. This makes them less than desired in social situations.</description>
				<statOffsets>
					<SocialImpact>-0.90</SocialImpact>
				</statOffsets>				
				<disallowedInspirations>
				  <li>Frenzy_Shoot</li>
				  <li>Frenzy_Work</li>
				  <li>Frenzy_Go</li>
				  <li>Inspired_Trade</li>
				  <li>Inspired_Recruitment</li>
				  <li>Inspired_Taming</li>
				  <li>Inspired_Surgery</li>
				  <li>Inspired_Creativity</li>
				</disallowedInspirations>
			</li>
		</degreeDatas>
	</TraitDef>
  <!-- M7 Mech Unfeeling Trait -->
  <TraitDef>
		<defName>MechAtlas</defName>
		<commonality>1</commonality>
		<degreeDatas>
			<li>
				<label>Mech</label>
				<description>A mechanized infantry unit, they do not think or feel.</description>
				<statOffsets>
					<SocialImpact>-0.90</SocialImpact>
				</statOffsets>
			</li>
		</degreeDatas>
	</TraitDef>
</Defs>