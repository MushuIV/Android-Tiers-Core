  <ThingDef ParentName="ATPP_GeneratorAI">
        <defName>ATPP_M8GeneratorAI</defName>
        <label>M8 prototype Mech</label>
        <comps>
		<li Class="MOARANDROIDS.SpawnerCompProperties_GenericSpawner">
            <compClass>MOARANDROIDS.CompAndroidSpawnerGeneric</compClass>
			<Pawnkind>M8MechPawn</Pawnkind>
		</li>
        </comps>
    </ThingDef>
  <!-- ==================== STANDARD SURROGATE SPAWNERS ==================== -->
  <ThingDef Name="ATPP_GeneratorAI" Abstract="True">
        <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
        <selectable>true</selectable>
        <drawerType>MapMeshAndRealTime</drawerType>
        <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
        <repairEffect>Repair</repairEffect>
        <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
        <filthLeaving>Filth_RubbleRock</filthLeaving>
        <description>Creates an surrogate android.</description>
        <graphicData>
            <texPath>Things/Alpha</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <thingClass>ThingWithComps</thingClass>
		<category>Filth</category>
		<altitudeLayer>Filth</altitudeLayer>
        <useHitPoints>True</useHitPoints>
        <statBases>
            <WorkToMake>550</WorkToMake>
            <MaxHitPoints>150</MaxHitPoints>
            <Flammability>0.1</Flammability>
        </statBases>
        <size>(1,1)</size>
        <passability>Standable</passability>
        <pathCost>200</pathCost>
        <hasInteractionCell>false</hasInteractionCell>
        <surfaceType>Item</surfaceType>
        <tickerType>Normal</tickerType>
    </ThingDef>
